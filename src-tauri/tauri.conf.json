{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BTC Keytool",
  "version": "0.2.0",
  "identifier": "com.btckeytool.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "BTC Keytool - offline", "width": 1120, "height": 820, "minWidth": 760, "minHeight": 520 }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
